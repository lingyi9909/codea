{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["summary", "scope", "findings", "observations", "uncertainObservations", "reviewStats", "businessKnowledgeUnavailable"],
  "properties": {
    "summary": {"type":"object","additionalProperties":false,"required":["result","text"],"properties":{"result":{"enum":["PASS","FAIL"]},"text":{"type":"string"}}},
    "scope": {"type":"object","additionalProperties":false,"required":["type","changedFiles"],"properties":{"type":{"enum":["staged","unstaged","base-branch","commit","range","file-path"]},"changedFiles":{"type":"array","items":{"type":"string"}}}},
    "findings": {"type":"array","items":{"type":"object","additionalProperties":false,"required":["file","lineRange","severity","title","description","evidence","introducedByChange","confidence","recommendation"],"properties":{"file":{"type":"string"},"lineRange":{"type":"object","required":["start","end"],"properties":{"start":{"type":"integer","minimum":1},"end":{"type":"integer","minimum":1}},"additionalProperties":false},"severity":{"enum":["Critical","Major","Minor","Suggestion"]},"title":{"type":"string"},"description":{"type":"string"},"evidence":{"type":"string"},"introducedByChange":{"type":"boolean"},"confidence":{"type":"number","minimum":0.8,"maximum":1},"recommendation":{"type":"string"}}}},
    "observations": {"type":"array","items":{"type":"object"}},
    "uncertainObservations": {"type":"array","items":{"type":"object"}},
    "reviewStats": {"type":"object","additionalProperties":false,"required":["filesReviewed","filesChanged","callChainsExpanded","critical","major","minor","suggestions"],"properties":{"filesReviewed":{"type":"integer","minimum":0},"filesChanged":{"type":"integer","minimum":0},"callChainsExpanded":{"type":"integer","minimum":0},"critical":{"type":"integer","minimum":0},"major":{"type":"integer","minimum":0},"minor":{"type":"integer","minimum":0},"suggestions":{"type":"integer","minimum":0}}},
    "businessKnowledgeUnavailable": {"type":"boolean"}
  }
}
